DB_HOST=localhost
DB_PORT=5432
DB_NAME=kcrm
DB_USERNAME=kcrm
DB_PASSWORD=kcrm

# base64 at least 256 bits -> openssl rand -base64 32
JWT_SECRET=
# duration: 1h, 30m, or plain milliseconds
JWT_EXPIRATION=1h

# Initial Admin, created at startup only when no active Admin exists
ADMIN_NOME=
ADMIN_EMAIL=
# at least 8 characters
ADMIN_SENHA=
# CPF with or without the mask; stored as 000.000.000-00
ADMIN_CPF=
# celular with DDD, with or without the mask; stored as (xx) xxxxx-xxxx
ADMIN_TELEFONE=
ADMIN_ENDERECO_RUA=
# "S/N" is accepted
ADMIN_ENDERECO_NUMERO=
ADMIN_ENDERECO_BAIRRO=
ADMIN_ENDERECO_CIDADE=
# UF sigla, e.g. CE
ADMIN_ENDERECO_ESTADO=
# with or without the mask; stored as 00000-000
ADMIN_ENDERECO_CEP=
# optional
ADMIN_ENDERECO_COMPLEMENTO=
