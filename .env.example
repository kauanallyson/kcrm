DB_HOST=localhost
DB_PORT=5432
DB_NAME=kcrm
DB_USERNAME=kcrm
DB_PASSWORD=kcrm

# base64 at least 256 bits -> openssl rand -base64 32
# Obrigatório também para o docker compose subir o serviço kcrm
JWT_SECRET=
# duration: 1h, 30m, or plain milliseconds
JWT_EXPIRATION=1h

# Administrador único, criado no startup se ainda não existir; deixe vazio para não criar nenhum
ADMINISTRADOR_EMAIL=
ADMINISTRADOR_SENHA=

REDIS_HOST=localhost
REDIS_PORT=6379

# requests per IP: login/cadastro per minute, rest of the API per second
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=100

# actuator/prometheus; only reachable inside the network, never through Traefik
MANAGEMENT_PORT=8081

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
