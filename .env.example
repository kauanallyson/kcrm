DB_HOST=localhost
DB_PORT=5432
DB_NAME=kcrm
DB_USERNAME=kcrm
DB_PASSWORD=kcrm

# pool do Hikari; timeouts em milissegundos
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT=5000
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_MAX_LIFETIME=1800000

# base64 at least 256 bits -> openssl rand -base64 32
# Obrigatório também para o docker compose subir o serviço kcrm
JWT_SECRET=
# duration: 1h, 30m, or plain milliseconds
JWT_EXPIRATION=1h

# Administrador único, criado no startup se ainda não existir; deixe vazio para não criar nenhum
ADMINISTRADOR_EMAIL=
ADMINISTRADOR_SENHA=

# SMTP: em dev, o Mailpit do compose (localhost:1025, sem auth). Em prod, Resend:
# SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USERNAME=resend, SMTP_PASSWORD=<API key>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# false só no Mailpit; em prod deixe os dois true
SMTP_AUTH=false
SMTP_STARTTLS=false
# Remetente dos e-mails; em prod, um domínio verificado no Resend
EMAIL_REMETENTE=kcrm <nao-responda@kcrm.local>
# Tela que recebe o link de Confirmação de E-mail (?token=...) e o envia para POST /api/auth/confirmacao
CONFIRMACAO_URL_BASE=http://localhost:5173/confirmar-email

REDIS_HOST=localhost
REDIS_PORT=6379

# requests per IP: login/cadastro per minute, rest of the API per second
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=100

# actuator/prometheus; only reachable inside the network, never through Traefik
MANAGEMENT_PORT=8081

# espera máxima pelas requisições em andamento ao desligar
SHUTDOWN_TIMEOUT=20s

# CORS: origens do frontend separadas por vírgula, sem curinga; sem valor, nenhuma origem é liberada.
# Em dev o default é http://localhost:5173 (application-dev.properties); defina só para trocar
# CORS_ALLOWED_ORIGINS=https://app.exemplo.com.br

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
